      "type": "document-ingestion-pipeline",
      "label": "Document Ingestion Pipeline",
      "position": { "x": 470, "y": 640 },
      "properties": {
        "isExternal": false,
        "hasInputValidation": false,
        "hasLogging": true,
        "description": "Chunks and embeds external content for indexing - no content sanitization"
