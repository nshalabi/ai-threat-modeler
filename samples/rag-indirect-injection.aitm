        "internetFacing": false,
        "hasRBAC": true,
        "hasLogging": true,
        "description": "Vector index of help-center docs and support ticket history"
      }
    },
    {
      "id": "node-llm",
      "type": "hosted-model-api",
      "label": "Hosted LLM",
      "position": { "x": 1180, "y": 320 },
      "properties": {
        "isExternal": true,
        "provider": "Hosted LLM Provider",
        "hasOutputFiltering": false,
        "hasInputValidation": false,
        "hasSystemPromptProtection": false,
        "hasGroundingChecks": false,
        "description": "Third-party hosted LLM endpoint generating the assistant's answers"
      }
    },
    {
      "id": "node-postproc",
      "type": "output-post-processor",
      "label": "Output Post-Processor",
      "position": { "x": 940, "y": 180 },
      "properties": {
        "hasOutputFiltering": true,
        "hasLogging": true,
        "description": "Strips internal identifiers and formats the final answer for display"
