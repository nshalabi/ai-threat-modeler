      "type": "identity-provider",
      "label": "Identity Provider",
      "position": { "x": 240, "y": 120 },
      "properties": {
        "handlesCredentials": true,
        "hasRBAC": true,
        "hasLogging": true,
        "description": "Authenticates customers before chat sessions"
      }
    },
    {
      "id": "node-gateway",
      "type": "api-gateway",
      "label": "API Gateway",
      "position": { "x": 470, "y": 320 },
      "properties": {
        "hasRBAC": true,
        "hasLogging": true,
        "internetFacing": true,
        "description": "Edge gateway terminating TLS and enforcing authentication"
      }
    },
    {
      "id": "node-rag",
      "type": "rag-orchestrator",
      "label": "RAG Orchestrator",
      "position": { "x": 700, "y": 320 },
      "properties": {
        "hasLogging": true,
        "hasInputValidation": false,
        "hasGroundingChecks": false,
        "description": "Builds prompts from the user question plus retrieved documents and calls the model"
      }
    },
