{
  "version": "1.0",
  "id": "sample-rag-indirect-injection",
  "name": "Customer-Support RAG Assistant (Indirect Injection)",
  "description": "A realistic enterprise customer-support assistant that answers questions using a RAG pipeline over public help-center docs and user-submitted support tickets. It demonstrates indirect prompt injection: untrusted external content is ingested and retrieved into the model context with no guardrail or moderation on the ingestion path.",
  "createdAt": "2026-05-01T00:00:00.000Z",
  "updatedAt": "2026-05-01T00:00:00.000Z",
  "nodes": [
    {
      "id": "node-customer",
      "type": "external-actor",
      "label": "Customer",
      "position": { "x": 0, "y": 320 },
      "properties": {
        "internetFacing": true,
        "isExternal": true,
        "description": "External customer interacting with the support assistant via the web"
      }
    },
    {
      "id": "node-webapp",
      "type": "web-app",
      "label": "Support Web App",
      "position": { "x": 240, "y": 320 },
      "properties": {
        "internetFacing": true,
        "hasInputValidation": true,
        "hasLogging": true,
        "description": "Customer-facing chat UI with basic request validation"
      }
    },
    {
