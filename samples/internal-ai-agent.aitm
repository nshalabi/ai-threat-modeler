  "notes": [
    {
      "id": "note-project-overview",
      "content": "This sample models an internal enterprise AI agent with broad tool access but no safety controls. The agent lacks RBAC, human approval flows, and logging. All three tool connectors can execute actions autonomously. Running analysis should produce 10+ findings covering agent security, missing logging, and uncontrolled tool execution.",
      "category": "general",
      "author": "sample-generator",
